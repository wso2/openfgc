# Optional config file path. If unset, defaults are used and env overrides apply.
BFF_CONFIG_FILE=

# Server
BFF_SERVER__HOST=0.0.0.0
BFF_SERVER__PORT=8080
BFF_SERVER__READ_TIMEOUT=15s
BFF_SERVER__WRITE_TIMEOUT=15s
BFF_SERVER__IDLE_TIMEOUT=60s
BFF_SERVER__SHUTDOWN_TIMEOUT=10s

# Logging
BFF_LOG__LEVEL=info

# Environment
BFF_ENV=development

# CORS (frontend integration)
BFF_CORS__ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
BFF_CORS__ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
BFF_CORS__ALLOWED_HEADERS=Content-Type,Authorization,X-Correlation-ID
BFF_CORS__ALLOW_CREDENTIALS=true

# Proxy
BFF_PROXY__OPENFGC_API_URL=http://localhost:8060
BFF_PROXY__OPENFGC_API_TIMEOUT=10s
BFF_PROXY__MAX_REQUEST_BYTES=1048576
BFF_PROXY__MAX_RESPONSE_BYTES=10485760
BFF_PROXY__ALLOWED_PASSTHROUGH_METHODS=["GET","POST","PUT","DELETE"]

# Placeholder identity mode for local development (must be false in production)
BFF_PROXY__PLACEHOLDER_MODE_ENABLED=false
BFF_PROXY__PLACEHOLDER_USER_ID=user1@example.com
BFF_PROXY__PLACEHOLDER_ORG_ID=ORG-001
BFF_PROXY__PLACEHOLDER_SCOPES=portal:consents:read:self portal:consents:write:self

# OIDC confidential-client authentication
BFF_AUTH__ENABLED=false
BFF_AUTH__ISSUER_URL=
BFF_AUTH__CLIENT_ID=
# Environment only; never place this secret in a YAML config file.
BFF_AUTH__CLIENT_SECRET=
BFF_AUTH__PORTAL_URL=http://localhost:5173/consents
BFF_AUTH__REDIRECT_URI=http://localhost:8080/auth/callback
BFF_AUTH__POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
BFF_AUTH__SCOPES=openid email profile portal:consents:read:self portal:consents:write:self portal:consents:read:any portal:consents:write:any portal:elements:read portal:elements:write portal:purposes:read portal:purposes:write
BFF_AUTH__RESOURCE_AUDIENCE=
BFF_AUTH__ALLOWED_SIGNING_ALGORITHMS=RS256
BFF_AUTH__HTTP_TIMEOUT=5s
BFF_AUTH__REFRESH_TIMEOUT=10s
BFF_AUTH__CLOCK_SKEW=30s
BFF_AUTH__SCOPE_CLAIM=scope
BFF_AUTH__ORG_ID_CLAIM=org_id
# Overrides the organization claim when non-empty. Leave empty to use BFF_AUTH__ORG_ID_CLAIM.
BFF_AUTH__ORG_ID_OVERRIDE=ORG-001
BFF_AUTH__REQUIRE_ACCESS_TOKEN_TYPE=false
BFF_AUTH__ACCESS_TOKEN_TYPE_CLAIM=token_type
BFF_AUTH__ACCESS_TOKEN_TYPE_VALUE=access_token
BFF_AUTH__ACCESS_TOKEN_PART1_COOKIE=portal-at-p1
BFF_AUTH__ACCESS_TOKEN_PART2_COOKIE=portal-at-p2
BFF_AUTH__REFRESH_TOKEN_PART1_COOKIE=portal-rt-p1
BFF_AUTH__REFRESH_TOKEN_PART2_COOKIE=portal-rt-p2
BFF_AUTH__ID_TOKEN_PART1_COOKIE=portal-id-p1
BFF_AUTH__ID_TOKEN_PART2_COOKIE=portal-id-p2
BFF_AUTH__OAUTH_STATE_COOKIE=portal-oauth-state
BFF_AUTH__PKCE_VERIFIER_COOKIE=portal-pkce-verifier
BFF_AUTH__COOKIE_SECURE=false
BFF_AUTH__COOKIE_SAME_SITE=Lax
BFF_AUTH__LOGIN_TRANSACTION_MAX_AGE_SECONDS=600
BFF_AUTH__REFRESH_COOKIE_MAX_AGE_SECONDS=86400
BFF_AUTH__MAX_TOKEN_PART_BYTES=3800
BFF_AUTH__MAX_RECONSTRUCTED_TOKEN_BYTES=7600
