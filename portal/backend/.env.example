# Optional config file path. If unset, defaults are used and env overrides apply.
BFF_CONFIG_FILE=

# Server
BFF_SERVER__HOST=0.0.0.0
BFF_SERVER__PORT=8080
BFF_SERVER__READ_TIMEOUT=15s
BFF_SERVER__WRITE_TIMEOUT=15s
BFF_SERVER__IDLE_TIMEOUT=60s
BFF_SERVER__SHUTDOWN_TIMEOUT=10s

# Logging
BFF_LOG__LEVEL=info

# Environment
BFF_ENV=development

# CORS (frontend integration)
BFF_CORS__ALLOWED_ORIGINS=https://localhost:5173
BFF_CORS__ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
BFF_CORS__ALLOWED_HEADERS=Authorization,Content-Type,X-Correlation-ID
BFF_CORS__ALLOW_CREDENTIALS=false

# OAuth resource-server authentication
BFF_AUTH__ISSUER_URL=https://localhost:8090
BFF_AUTH__RESOURCE_AUDIENCE=consent-api
BFF_AUTH__ALLOWED_ALGORITHMS=RS256
BFF_AUTH__JWKS_TTL=5m
BFF_AUTH__JWKS_REFRESH_TIMEOUT=5s
BFF_AUTH__CLOCK_SKEW=30s
# Enable only when the IdP provides a reliable access-token type claim.
BFF_AUTH__REQUIRE_ACCESS_TOKEN_TYPE=false
BFF_AUTH__TOKEN_TYPE_CLAIM=token_type
BFF_AUTH__ACCESS_TOKEN_TYPE=access_token

# Proxy
BFF_PROXY__OPENFGC_API_URL=http://localhost:8060
BFF_PROXY__OPENFGC_API_TIMEOUT=10s
BFF_PROXY__MAX_REQUEST_BYTES=1048576
BFF_PROXY__MAX_RESPONSE_BYTES=10485760
BFF_PROXY__ALLOWED_PASSTHROUGH_METHODS=["GET","POST","PUT","DELETE"]

# Placeholder identity mode (For dev/test only; must be false in production)
BFF_PROXY__PLACEHOLDER_MODE_ENABLED=false
BFF_PROXY__PLACEHOLDER_USER_ID=
BFF_PROXY__PLACEHOLDER_ORG_ID=
BFF_PROXY__PLACEHOLDER_CLIENT_ID=
